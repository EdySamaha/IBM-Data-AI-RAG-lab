# ---------------------------------------------------------------------------
# Lab credentials — copy this file to ".env" and fill in your own values.
#   cp .env.template .env
# The .env file is git-ignored and must never be committed.
#
# You only need this file for the LOCAL scripts (scripts/verify_setup.py).
# Inside watsonx.ai, you paste these values directly into the notebook cells.
# ---------------------------------------------------------------------------

# --- watsonx.ai ---
# IBM Cloud API key: IBM Cloud console -> Manage -> Access (IAM) -> API keys.
IBM_CLOUD_API_KEY=

# watsonx.ai project ID: open your project -> Manage -> General -> Project ID.
WATSONX_PROJECT_ID=

# Region endpoint for your watsonx.ai project. Must match where the project
# lives. Examples:
#   https://us-south.ml.cloud.ibm.com   (Dallas)
#   https://eu-de.ml.cloud.ibm.com      (Frankfurt)
#   https://ca-tor.ml.cloud.ibm.com     (Toronto)
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# --- watsonx.data: Presto (SQL) engine ---
# From the engine's "Connect" / connection-details panel in watsonx.data.
PRESTO_HOST=
PRESTO_PORT=443
PRESTO_USER=
PRESTO_PWD=

# --- watsonx.data: Milvus (vector) engine ---
# From the Milvus engine's connection-details panel in watsonx.data.
MILVUS_HOST=
MILVUS_PORT=
MILVUS_USER=
MILVUS_PWD=
